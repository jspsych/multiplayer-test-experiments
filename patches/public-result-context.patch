+    getResultContext: capture,
+    validateResultContext: (x: any) => typeof x?.directorDescribed === "boolean",
+  });
+  await p.ready();
+  if (timeout) await p.advance(1000); else p.a.submit({ choice: "A" });
+  await drain();
+  observed.directorDescribed = false;
+  expect(capture).toHaveBeenCalledTimes(1);
+  expect(p.a.state.result!.context).toEqual({ directorDescribed: true });
+  expect(p.b.state.result).toEqual(p.a.state.result);
